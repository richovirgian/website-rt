# ==========================================
.claude/
.agents/
.gemini/
.cursor/
.cursorrules
CLAUDE.md
AGENTS.md
PROMPT-*.md
CONTENT-MODEL.md
DESIGN.md

# Catatan kerja internal: spec, rencana implementasi, postmortem.
# Berguna di mesin sendiri, tidak untuk dibagikan lewat GitLab.
/docs/

# ==========================================
# IDEs & Code Editors
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.code-workspace

# ==========================================
# Prisma Client tergenerate
# ==========================================
# Dibangun ulang oleh `prisma generate` (dipanggil lewat postinstall).
# 8 MB berisi WASM — tidak ada gunanya masuk riwayat git.
/lib/generated/
