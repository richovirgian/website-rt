# Domain situs. Dipakai untuk canonical, sitemap.xml, robots.txt, dan Open
# Graph. Tanpa garis miring di akhir.
#
# SENGAJA TANPA awalan NEXT_PUBLIC_. Next membekukan setiap NEXT_PUBLIC_*
# menjadi nilai literal saat build — di bundel peramban MAUPUN di kode server.
# Satu image yang dibangun CI lalu dipakai lintas lingkungan akan membawa nilai
# saat build selamanya, dan mengisi ulang env di Kubernetes tidak berpengaruh
# apa pun. Tanpa awalan itu, nilainya dibaca proses server saat berjalan, jadi
# ganti domain cukup restart pod. Alasannya sama persis dengan TURNSTILE_SITE_KEY
# di bawah.
DOMAIN_SITE_URL=https://websitedesa.example

# Pengaman indeks DAN saklar analytics. Biarkan kosong atau "false" di mana pun
# kecuali produksi. Selama belum "true": robots.txt menolak semua perayap, tiap
# halaman mengirim noindex, dan Google Tag Manager tidak dimuat — supaya deploy
# preview atau staging tidak masuk indeks Google sebagai konten duplikat, dan
# kunjungan kita sendiri saat menguji tidak mengotori laporan analytics.
#
# Tanpa awalan NEXT_PUBLIC_ dengan alasan yang sama seperti DOMAIN_SITE_URL:
# nilainya harus dibaca saat pod berjalan, bukan saat image dibangun.
SITE_IS_LIVE=false

# Koneksi PostgreSQL.
# Lokal (Postgres via Homebrew): postgresql://<user>@localhost:5432/desa_web
# Produksi: gunakan connection string dari penyedia, sertakan ?sslmode=require
DATABASE_URL=postgresql://user@localhost:5432/desa_web

# Kunci penandatangan sesi CMS. Buat nilai acak sendiri:
#   openssl rand -base64 32
# Berbeda di tiap lingkungan. Kalau berubah, semua sesi yang berjalan gugur.
BETTER_AUTH_SECRET=
# Alamat asal aplikasi, dipakai untuk cookie dan pengalihan setelah masuk.
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare Turnstile untuk formulir masuk.
#
# Kunci situs memang publik dan ikut terkirim ke peramban, tetapi namanya
# sengaja TANPA awalan NEXT_PUBLIC_. Next membekukan setiap NEXT_PUBLIC_*
# menjadi nilai literal saat build, di bundel peramban maupun SSR. Kunci yang
# belum ada di mesin pembangun image akan selamanya kosong di peramban,
# widget-nya hilang saat hidrasi, dan SETIAP kiriman formulir dijawab 403 —
# betapapun benar isi env di Kubernetes. Tanpa awalan itu, nilainya dibaca
# server tiap permintaan lalu dioper ke formulir sebagai prop, jadi satu image
# bisa dipakai lintas lingkungan dan ganti kunci cukup restart pod.
#
# Hostname dipisah koma, ditulis telanjang: dev.websitedesa.example
# Skema, port, dan jalur ikut dibuang bila terlanjur ditulis, jadi
# https://dev.websitedesa.example/ juga diterima.
# JANGAN memuat localhost di produksi: itu membuat token yang dibuat di mesin
# siapa pun diterima oleh server produksi.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
#
# Dua kunci di atas juga menjaga /admin/masuk. Di sana keduanya diperlakukan
# sepasang: bila salah satu kosong, lapisan captcha login MATI dan login tetap
# bisa dipakai. Itu disengaja — secret tanpa site key akan mengunci seluruh
# admin dari CMS-nya sendiri, dan yang tergadai di sini bukan pesan masuk
# melainkan akses pengelolaan. Matinya lapisan itu berteriak di log server.

# Kunci enkripsi NIK warga (32 byte, base64). Buat dengan:
#   openssl rand -base64 32
# JANGAN hilang atau diganti: NIK yang sudah tersimpan tidak bisa dibuka lagi
# tanpanya. Simpan salinan di tempat aman, terpisah dari database.
ENKRIPSI_KUNCI=
